{
  "baseBranch": "main",
  "install": ["npm", "ci"],
  "agent": {
    "command": ["claude", "-p", "--permission-mode", "acceptEdits"],
    "maxFixRounds": 3
  },
  "gates": [
    { "name": "typecheck", "run": ["npm", "run", "typecheck"] },
    { "name": "test", "run": ["npm", "test"] },
    { "name": "build", "run": ["npm", "run", "build"] }
  ],
  "preview": { "enabled": true, "timeoutSec": 600, "path": "/api/health" },
  "merge": {
    "auto": true,
    "requiredCheck": "test",
    "maxRisk": "low",
    "method": "squash"
  }
}
